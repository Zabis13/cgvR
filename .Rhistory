"ggplot2" %in% rownames(available.packages())
# Сравниваем версии в разных форматах
pkgs_bin <- available.packages(type = "win.binary")
pkgs_src <- available.packages(type = "source")
package_name <- "ggplot2"
cat("Бинарная версия:", pkgs_bin[package_name, "Version"], "\n")
cat("Версия из исходников:", pkgs_src[package_name, "Version"], "\n")
# Сравниваем версии в разных форматах
pkgs_bin <- available.packages(type = "win.binary")
pkgs_src <- available.packages(type = "source")
package_name <- "ggmlR"
cat("Бинарная версия:", pkgs_bin[package_name, "Version"], "\n")
# Проверка наличия исходников .tar.gz
"ggmlR" %in% rownames(available.packages(type = "source"))
# Проверка наличия готового .zip файла
"ggmlR" %in% rownames(available.packages(type = "win.binary"))
# Версия готового файла для Windows
bin_ver <- available.packages(type = "win.binary")["ggmlR", "Version"]
getRversion()
# Обновляем список пакетов с главного сервера
db <- available.packages(repos = "https://r-project.org", type = "win.binary")
# Проверяем, появился ли ggmlR в списке
if ("ggmlR" %in% rownames(db)) {
print(db["ggmlR", c("Package", "Version")])
} else {
print("Пакет все еще не виден в бинарниках")
}
# Получаем базу данных проверок CRAN (может занять время)
checks <- tools::CRAN_package_db()
# Ищем статус ggmlR для вашей платформы
subset(checks, Package == "ggmlR", select = c(Package, Version, Status, Flavor))
# Получаем детальные данные о проверках
details <- tools::CRAN_check_details("ggmlR")
# Оставляем только строки для Windows
win_status <- details[grep("windows", details$Flavor), ]
if (nrow(win_status) == 0) {
print("Данные о проверках для Windows еще не поступили.")
} else {
print(win_status[, c("Package", "Flavor", "Status", "Check")])
}
# 1. Посмотрим, какой именно сервер (зеркало) использует ваш R
cat("Ваше текущее зеркало:", getOption("repos")["CRAN"], "\n")
# 2. Попробуем скачать индекс ПРЯМО с облачного сервера, игнорируя настройки
db_cloud <- available.packages(repos = "https://r-project.org", type = "win.binary")
# 3. Есть ли пакет в облачном индексе?
in_cloud <- "ggmlR" %in% rownames(db_cloud)
cat("Пакет есть в облачном индексе?", in_cloud, "\n")
# 4. Если в облаке он есть, а у вас FALSE — значит ваше зеркало устарело.
# 5. Если и в облаке FALSE — значит CRAN еще не обновил файл PACKAGES.gz для Windows.
# Используем официальное облачное зеркало
db_cloud <- available.packages(repos = "https://cloud.r-project.org", type = "win.binary")
# Проверяем наличие
in_cloud <- "ggmlR" %in% rownames(db_cloud)
cat("Пакет есть в облачном индексе?", in_cloud, "\n")
# Если TRUE, посмотрим версию
if(in_cloud) print(db_cloud["ggmlR", "Version"])
# Используем официальное облачное зеркало
db_cloud <- available.packages(repos = "https://cloud.r-project.org", type = "win.binary")
# Проверяем наличие
in_cloud <- "ggmlR" %in% rownames(db_cloud)
cat("Пакет есть в облачном индексе?", in_cloud, "\n")
# Если TRUE, посмотрим версию
if(in_cloud) print(db_cloud["ggmlR", "Version"])
